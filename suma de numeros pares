public class NumerosPares  {
    public static void main(String[] args) {
    System.out.print("Bucle para calcular la suma de todos los numeros pares entre 1 y 100 \n");
    int suma=0;
    for(int i=0; i <=100; i++){
      if(i%2==0){
        suma= suma+i;
        }
       }
       System.out.print("La suma de todos los numeros pares es "+suma); 

    }
}
