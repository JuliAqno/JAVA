import java.util.Scanner;

public class ContrasenaSecreta {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        String passwordCorrecta = "java123";
        String intento = ""; // Variable para guardar lo que escribe el usuario
        
        // El bucle se repite MIENTRAS el intento sea DIFERENTE (!= .equals) a la contraseña
        while (!intento.equals(passwordCorrecta)) {
            System.out.print("Ingrese la contraseña: ");
            intento = scanner.nextLine();
            
            if (!intento.equals(passwordCorrecta)) {
                System.out.println("Contraseña incorrecta. Intente de nuevo.\n");
            }
        }
        
        System.out.println("¡Contraseña correcta! Acceso concedido.");
        scanner.close();
    }
}
